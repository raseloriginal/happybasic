APP_NAME="HappyBasic"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/happybasic
APP_TIMEZONE=UTC

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=happybasic
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Internal polyglot services
INTERNAL_SERVICE_TOKEN=change-me-in-production
SERVICE_TIMEOUT=5

SERVICE_NODE_URL=http://127.0.0.1:3001
SERVICE_NODE_PORT=3001

SERVICE_PYTHON_URL=http://127.0.0.1:8001
SERVICE_PYTHON_PORT=8001
